  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mdi/font": "^7.1.96",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
