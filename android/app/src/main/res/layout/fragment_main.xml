<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainFragment" >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:paddingBottom="@dimen/dp_5"
        app:title="@string/app_name"
        app:titleTextColor="?attr/colorOnPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/selectorBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/custom_spn_background"
        app:layout_constraintBottom_toBottomOf="@id/valueSpinnerFrame"
        app:layout_constraintTop_toTopOf="@id/subvalueSpinnerFrame" />

    <FrameLayout
        android:id="@+id/valueSpinnerFrame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_spn_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.448"
        app:layout_constraintWidth_percent="0.689">
        <Spinner
            android:id="@+id/valueSpinner"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/subvalueSpinnerFrame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_spn_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/valueSpinnerFrame"
        app:layout_constraintHorizontal_bias="0.448"
        app:layout_constraintWidth_percent="0.689">
        <Spinner
            android:id="@+id/subvalueSpinner"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ideas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="@+id/valueSpinnerFrame"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/subvalueSpinnerFrame" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addIdea"
        android:layout_width="68dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_10"
        android:contentDescription="@string/add_idea"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="+"
        android:textColor="?attr/colorOnSecondary"
        android:textSize="36sp"
        app:backgroundTint="@color/teal_700"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toTopOf="@id/subvalueSpinnerFrame"
        app:layout_constraintBottom_toBottomOf="@id/valueSpinnerFrame"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
