<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainFragment" >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:paddingBottom="@dimen/dp_5"
        app:title="@string/app_name"
        app:titleTextColor="?attr/colorOnPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selectorDock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/idea_pane_margin"
        android:clipToOutline="true"
        app:cardBackgroundColor="@color/selector_dock_surface"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/selector_outline"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/selectorBackground"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/selector_group_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/valueSpinnerFrame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.448"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.689">

                <Spinner
                    android:id="@+id/valueSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/selector_content"
                    android:spinnerMode="dialog" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/subvalueSpinnerFrame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toTopOf="@id/valueSpinnerFrame"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.448"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.689">

                <Spinner
                    android:id="@+id/subvalueSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/selector_content"
                    android:spinnerMode="dialog" />
            </FrameLayout>

            <View
                android:id="@+id/selectorDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@color/selector_divider"
                app:layout_constraintEnd_toEndOf="@id/selectorBackground"
                app:layout_constraintStart_toStartOf="@id/selectorBackground"
                app:layout_constraintTop_toTopOf="@id/valueSpinnerFrame" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addIdea"
                android:layout_width="68dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="@dimen/dp_10"
                android:background="@drawable/selector_button_background"
                android:contentDescription="@string/add_idea"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textColor="@color/selector_content"
                android:textSize="36sp"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ideasPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/idea_pane_margin"
        android:clipToOutline="true"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/idea_pane_outline"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/selectorDock">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ideas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="true"
            android:overScrollMode="never"
            android:padding="@dimen/idea_list_padding" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
