<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/firstIdeaSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.18"
        android:background="?attr/colorControlNormal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ideaContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/lastIdeaSeparator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/firstIdeaSeparator">

        <TextView
            android:id="@+id/ideaName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textAppearance="@android:style/TextAppearance.Material.Body1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/ideaDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.72"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="@android:style/TextAppearance.Material.Body2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/deleteIdea"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_5"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/delete_idea"
        android:focusable="true"
        android:src="@drawable/delete_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/firstIdeaSeparator" />

    <LinearLayout
        android:id="@+id/ideaEditor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/confirmEditIdea"
        app:layout_constraintStart_toEndOf="@id/deleteIdea"
        app:layout_constraintTop_toBottomOf="@id/firstIdeaSeparator">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ideaEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:hint="@string/name"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ideaDescriptionEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/description"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/confirmEditIdea"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/dp_5"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/save_idea"
        android:focusable="true"
        android:src="@drawable/confirm_edit_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/firstIdeaSeparator" />

    <View
        android:id="@+id/lastIdeaSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.18"
        android:background="?attr/colorControlNormal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
